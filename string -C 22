#include <stdio.h>
#include <string.h>

int main(){
    char ip[100];
    int i,count=1,n=0;
    
    printf("Enter The Sentence:");
    
    fgets(ip,sizeof(ip),stdin);
    
    scanf("\n%[^\n]s",ip);
    printf("Your Typed Sentence: %s\n ",ip);
    
    for(i=0;ip[i]!='\0';i++){
        char ch=ip[i];
        
        if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u'||ch=='A'||ch=='E'||ch=='I'||ch=='O'||ch=='U'){
            printf("%d",count);
            count++;
        }
        
        else{
            printf("%c",ch);
        }
    }
    
    return 0;
    
}
